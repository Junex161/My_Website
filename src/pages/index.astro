---
import Base from '../layouts/Base.astro';
---
<Base title="Home" bare>
  <section class="hero">
    <canvas class="sky-canvas" data-sky aria-hidden="true"></canvas>
    <div class="wrap hero-text">
      <h1>Julian Karcher</h1>
      <p>Research Master student in Psychology at the University&nbsp;of&nbsp;Amsterdam.</p>
    </div>
  </section>
</Base>

<script>
  import { mountSky } from '../scripts/sky';
  const canvas = document.querySelector<HTMLCanvasElement>('[data-sky]');
  if (canvas) mountSky(canvas);
</script>

<style>
  :global(body.bare) { overflow: hidden; }
  .hero { position: relative; height: 100svh; min-height: 480px; overflow: hidden; display: flex; align-items: flex-end; }
  .sky-canvas { position: absolute; inset: 0; width: 100%; height: 100%; opacity: 0; transition: opacity 1.2s ease; touch-action: none; }
  .sky-canvas:global(.ready) { opacity: 1; }
  .hero-text { position: relative; padding-bottom: clamp(48px, 11vh, 120px); pointer-events: none; }
  h1 { font-size: clamp(3rem, 9vw, 7.5rem); font-stretch: 125%; font-weight: 700; line-height: .95; letter-spacing: -0.02em; max-width: 9ch; }
  .hero-text p { margin-top: 22px; max-width: 34ch; font-size: clamp(1.05rem, 1.6vw, 1.3rem); color: var(--ink-2); }
</style>
